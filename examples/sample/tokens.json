{
  "name": "Sample Design System",
  "version": 1,
  "color": {
    "themes": [{ "id": "dark", "name": "Dark" }, { "id": "light", "name": "Light" }],
    "tokens": [
      { "name": "sample-teal", "value": "#2EC4B6", "usage": "Accent." },
      { "name": "sample-ink", "value": "#0E1420", "usage": "Ground." },
      { "name": "sample-paper", "value": "#F7F7F2", "usage": "Light ground." },
      { "name": "bg-page", "value": { "dark": "{sample-ink}", "light": "{sample-paper}" }, "usage": "Page background." },
      { "name": "bg-panel", "value": { "dark": "rgba(14, 20, 32, 0.86)", "light": "rgba(255, 255, 255, 0.9)" }, "usage": "Panel." },
      { "name": "fg-1", "value": { "dark": "#FFFFFF", "light": "{sample-ink}" }, "usage": "Primary text." },
      { "name": "accent-default", "value": { "dark": "{sample-teal}", "light": "{sample-teal}" }, "usage": "Accent." }
    ]
  },
  "type": {
    "fonts": [{ "family": "Sample Sans", "file": "timecode.ttf", "weight": "500", "style": "normal" }],
    "families": { "display": "\"Sample Sans\", sans-serif", "body": "\"Sample Sans\", sans-serif" },
    "groups": [
      { "name": "Display", "family": "display", "styles": [
        { "name": "sample-display", "fontSize": "120px", "lineHeight": "1", "fontWeight": 500, "letterSpacing": "0.01em" } ] },
      { "name": "Text", "family": "body", "styles": [
        { "name": "sample-eyebrow", "fontSize": "28px", "lineHeight": "1.2", "fontWeight": 500, "letterSpacing": "0.16em" },
        { "name": "sample-body", "fontSize": "40px", "lineHeight": "1.4", "fontWeight": 500 } ] }
    ]
  },
  "radius": { "tokens": [{ "name": "radius-md", "value": "12px", "usage": "Panels." }] }
}
